---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TrustMeter from '../components/TrustMeter.astro';
import { profile, githubUrl } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  footerGame?: boolean; // the footer's dodge.exe (the 404 page has its own)
  meter?: boolean; // the Explored meter (nothing to explore on the 404 page)
}

const {
  title = `${profile.name} · ${profile.title}`,
  footerGame = true,
  meter = true,
  description = `${profile.name} is a ${profile.title.toLowerCase()} at ${profile.school} who builds web apps and is exploring AI engineering.`,
} = Astro.props;

const base = Astro.site ?? Astro.url; // the live domain on Vercel (see astro.config.mjs)
const canonical = new URL(Astro.url.pathname, base);
const ogImage = new URL('/og.png', base); // public/og.png, 1200×630

// Structured data for search engines (schema.org Person), on the homepage only: who this site is about,
// and which accounts are the same person, so a search for the name can connect them. Built from profile.ts.
const person = Astro.url.pathname === '/' && {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: ['El', profile.github],
  jobTitle: profile.title,
  description,
  url: new URL('/', base).href,
  image: ogImage.href,
  affiliation: { '@type': 'CollegeOrUniversity', name: profile.school },
  knowsAbout: ['Full-stack web development', 'Java', 'TypeScript', 'Python', 'AI engineering', 'Worldbuilding'],
  sameAs: [githubUrl, profile.linkedin, profile.fiverr],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-var.woff" as="font" type="font/woff" crossorigin />
    <meta name="theme-color" content="#F4EFE4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12110E" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {person && <script type="application/ld+json" set:html={JSON.stringify(person)} />}

    <!-- Turns on the reveal-ready states only when scripts run, so nothing hides without JS -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Light or dark before the first paint: the visitor's choice, else their system setting -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'dark' && t !== 'light') t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer game={footerGame} />
    {meter && <TrustMeter />}
    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>
