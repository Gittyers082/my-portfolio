---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TrustMeter from '../components/TrustMeter.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  footerGame?: boolean; // the footer's dodge.exe (the 404 page has its own)
  meter?: boolean; // the Explored meter (nothing to explore on the 404 page)
}

const {
  title = `${profile.name} · ${profile.title}`,
  footerGame = true,
  meter = true,
  description = `${profile.name} is a ${profile.title.toLowerCase()} at ${profile.school} who builds web apps and is exploring AI engineering.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? profile.site);
// TODO: add public/og.png (1200×630) and it will be picked up here
const ogImage = new URL('/og.png', Astro.site ?? profile.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-var.woff" as="font" type="font/woff" crossorigin />
    <meta name="theme-color" content="#F4EFE4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12110E" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Turns on the reveal-ready states only when scripts run, so nothing hides without JS -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Light or dark before the first paint: the visitor's choice, else their system setting -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'dark' && t !== 'light') t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer game={footerGame} />
    {meter && <TrustMeter />}
    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>
