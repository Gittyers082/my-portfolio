---
/**
 * ThriftBite demo loop: a reservation played through like a muted clip.
 * Drawn in ThriftBite's own colours (it's a screen of a different app, so it
 * stays light in dark mode, like a screenshot would). Listings are real ones
 * from the live app. Logic: src/scripts/features.ts (initDemo), shared with Ka-dugo.
 * Without JavaScript the first screen shows and the controls stay hidden.
 */
const steps = ['Find a deal', 'Reserve it', 'Pick it up tonight'];
const deals = [
  { name: 'Pandesal, bag of 10', store: 'Sunrise Bakery', now: '₱25.00', was: '₱50.00', off: '50% off', closes: 'Closes in 2 h 0 m', left: '3 left', picked: true, glyph: 'bread' },
  { name: 'Chicken adobo with rice', store: 'Lola Ising’s Carinderia', now: '₱60.00', was: '₱95.00', off: '37% off', closes: 'Closes in 2 h 30 m', left: '6 left', glyph: 'bowl' },
  { name: 'Strawberry taho, 2 cups', store: 'Burnham Taho Cart', now: '₱20.00', was: '₱35.00', off: '43% off', closes: 'Closes in 1 h 0 m', left: '8 left', glyph: 'cup' },
];
const glyphs: Record<string, string> = {
  bread: 'M10 30 C10 18 18 12 32 12 C46 12 54 18 54 30 C54 34 51 36 48 36 L48 50 L16 50 L16 36 C13 36 10 34 10 30 Z M24 22 L22 30 M32 20 L32 30 M40 22 L42 30',
  bowl: 'M8 30 H56 C56 42 46 50 32 50 C18 50 8 42 8 30 Z M20 30 C20 22 26 18 32 18 C38 18 44 22 44 30 M26 54 H38',
  cup: 'M18 18 H46 L42 52 H22 Z M16 18 H48 M24 12 C24 8 28 8 28 12 M34 12 C34 8 38 8 38 12',
};
---
<figure class="demo demo--tb" data-demo data-step="0">
  <div class="demo__frame">
    <div class="screen screen--tb" data-ui>
      <div class="screen__bar">
        <span class="screen__dot"></span><span class="screen__dot"></span><span class="screen__dot"></span>
        <span class="screen__url">thriftbite.vercel.app</span>
        <span class="demo__status" aria-hidden="true"><span class="demo__rec"></span><span class="demo__status-text">Demo loop</span></span>
      </div>
      <div class="screen__body tb" aria-live="off">
        <div class="tb__nav" aria-hidden="true">
          <span class="tb__brand"><img src="/projects/thryx-head.webp" alt="" width="28" height="28" loading="lazy" decoding="async">ThriftBite</span>
          <span class="tb__tab tb__tab--on">Browse</span>
          <span class="tb__tab">Reservations</span>
          <span class="tb__cart">Cart</span>
        </div>

        <div class="demo__screen tb__screen" data-screen="0" aria-label="Step 1 of 3: tonight’s deals, closing soonest first">
          <div class="tb__hero">
            <div>
              <p class="tb__hero-h">Tonight’s surplus, saved before closing.</p>
              <p class="tb__hero-sub">End-of-day food from Baguio bakeries and carinderias.</p>
            </div>
            <img class="tb__mascot" src="/projects/thryx-full.webp" alt="" width="120" height="117" loading="lazy" decoding="async">
          </div>
          <div class="tb__count"><span>9 deals you can still pick up tonight</span><span class="tb__live">Live</span></div>
          <div class="tb__deals">
            {deals.map((d) => (
              <div class:list={['tb__deal', { 'tb__deal--picked': d.picked }]}>
                <div class="tb__img">
                  <span class="tb__off">{d.off}</span>
                  <svg viewBox="0 0 64 64" aria-hidden="true"><path d={glyphs[d.glyph]}></path></svg>
                </div>
                <div class="tb__deal-body">
                  <b>{d.name}</b>
                  <span class="tb__store">{d.store}</span>
                  <span><b>{d.now}</b> <s>{d.was}</s></span>
                  <span class="tb__meta">{d.closes} · {d.left}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="demo__screen tb__screen" data-screen="1" aria-label="Step 2 of 3: reserving a bag of pandesal from Sunrise Bakery">
          <div class="tb__detail">
            <div class="tb__img tb__img--big">
              <span class="tb__off">50% off</span>
              <svg viewBox="0 0 64 64" aria-hidden="true"><path d={glyphs.bread}></path></svg>
            </div>
            <div class="tb__detail-body">
              <span class="tb__store">Sunrise Bakery</span>
              <p class="tb__detail-h">Pandesal, bag of 10</p>
              <p class="tb__price"><b>₱25.00</b> <s>₱50.00</s></p>
              <div class="tb__line"><span>Pick up</span><b>5:30 to 8:30 PM</b></div>
              <div class="tb__line"><span>Closes in</span><b>2 h 0 m</b></div>
              <div class="tb__line tb__line--live"><span><span class="tb__dot"></span>Stock, live</span><b class="tb__stock"><span class="tb__stock-a">3 left</span><span class="tb__stock-b">2 left</span></b></div>
              <div class="tb__buy"><span class="tb__qty">− 1 +</span><span class="tb__btn">Reserve for pickup</span></div>
            </div>
          </div>
        </div>

        <div class="demo__screen tb__screen tb__screen--done" data-screen="2" aria-label="Step 3 of 3: reserved, ready to pick up tonight">
          <div class="tb__done">
            <span class="tb__check"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 L9.5 18 L20 6.5" fill="none" stroke="#102326" stroke-width="3.2" stroke-linecap="square"></path></svg></span>
            <div><p class="tb__done-h">Reserved!</p><p class="tb__store">Saved before closing.</p></div>
          </div>
          <div class="tb__ticket">
            <div class="tb__ticket-row"><b>Pandesal, bag of 10</b><span>× 1</span></div>
            <span class="tb__store">Sunrise Bakery</span>
            <div class="tb__ticket-row"><span>Pick up tonight</span><b>5:30 to 8:30 PM</b></div>
            <div class="tb__ticket-row"><span>₱25.00</span><b class="tb__saved">you saved ₱25.00</b></div>
          </div>
          <p class="tb__store">It’s waiting under Reservations.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="demo__controls" hidden>
    <button type="button" class="demo__play" aria-label="Pause demo" data-demo-play>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path class="demo__icon-pause" d="M4 3 H8 V17 H4 Z M12 3 H16 V17 H12 Z"></path><path class="demo__icon-play" d="M5 3 L17 10 L5 17 Z"></path></svg>
    </button>
    {steps.map((label, i) => (
      <button type="button" class="demo__step" data-demo-step={i} aria-pressed={i === 0 ? 'true' : 'false'}>
        <span class="demo__step-label">{label}</span>
        <span class="demo__track"><span class="demo__fill"></span></span>
      </button>
    ))}
  </div>
  <figcaption class="demo__caption">Real listings from the live app, replayed as a loop. Hover to pause.</figcaption>
</figure>
