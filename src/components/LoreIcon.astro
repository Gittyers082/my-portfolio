---
/** Line icons for the lore archive, drawn to match StackIcon. */
interface Props { name: 'universe' | 'power' | 'oc' }
const { name } = Astro.props;
---
<span class="stack-icon lore-icon" aria-hidden="true">
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" stroke-linejoin="miter">
    {name === 'universe' && (
      <>
        <circle cx="16" cy="16" r="6"></circle><ellipse cx="16" cy="16" rx="14" ry="5.5" transform="rotate(-22 16 16)"></ellipse><circle cx="27" cy="7" r="1.6"></circle>
      </>
    )}
    {name === 'power' && (
      <path d="M18.5 3 L7 18 H15 L13 29 L25 13 H17 Z"></path>
    )}
    {name === 'oc' && (
      <>
        <circle cx="16" cy="10.5" r="5.5"></circle><path d="M5 29 C5 21 10 18 16 18 C22 18 27 21 27 29"></path><path d="M11 9.5 H21"></path>
      </>
    )}
  </svg>
</span>
