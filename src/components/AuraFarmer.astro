---
/**
 * The hero, seen from behind as always, standing on a rock in the Tagline's
 * wind with his arms crossed and a cape that won't stop moving. Aura farming.
 * - The calm cape is an SVG path that morphs between shapes (SMIL <animate>), so it
 *   moves in every browser; aura.ts pauses it off screen and for reduced motion.
 * - Comments pop up out of nowhere around him while the section is on screen.
 * - Pressing him sends a gust: the cape snaps and "+100 aura" floats up.
 * - Ten gusts in a row (or typing "arete") power him up: a living aura, a leap off the
 *   rock, lightning, a random weapon from his seven (src/data/weapons.ts), one hit that splits the
 *   rock (with the greatbow, one arrow), then back up.
 *   Narrow screens get a shorter version on the rock; reduced motion gets one still frame.
 * Logic: src/scripts/aura.ts · motion: global.css (search "power-up")
 */
import { WEAPON_ART } from '../data/weapons';
import Lightning from './Lightning.astro';

const INK = '#15130F';
const LIGHT = '#F4EFE4';
// three cape shapes with the same commands, so the morph is smooth: resting, lifted, settling
const CAPE = [
  'M132 140 C122 180 120 222 124 262 C150 272 172 252 198 258 C224 264 248 236 274 232 C290 229 302 214 314 204 C288 196 264 188 242 172 C228 162 216 150 208 140 Z',
  'M132 140 C120 176 116 214 118 250 C146 256 166 236 194 238 C222 240 246 210 272 204 C290 200 304 182 318 170 C292 168 266 166 244 158 C228 152 216 146 208 140 Z',
  'M132 140 C124 182 124 226 128 266 C154 274 176 262 202 266 C228 270 250 254 276 252 C292 250 302 240 312 232 C286 218 264 204 244 184 C230 168 216 152 208 140 Z',
];
const FOLD = ['M168 146 C162 190 164 226 170 256', 'M168 146 C160 184 160 214 166 240', 'M168 146 C164 192 168 230 176 262'];
const seq = (f: string[]): string => [f[0], f[1], f[0], f[2], f[0]].join(';');
const SPLINES = '0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1';
---
<div class="farmer" data-aura data-weapon="sword">
  <button class="farmer__btn" type="button" aria-label="The hero, aura farming on a rock. Press for a gust of wind; ten in a row powers him up." data-aura-btn>
    <svg viewBox="0 0 340 472" aria-hidden="true" data-aura-svg>
      <defs>
        <filter id="af-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="4"></feGaussianBlur></filter>
        <pattern id="af-dots" width="7" height="7" patternUnits="userSpaceOnUse"><circle cx="3.5" cy="3.5" r="1.4" fill="#15130F"></circle></pattern><filter id="af-flameA" x="-40%" y="-40%" width="180%" height="180%"><feTurbulence type="fractalNoise" baseFrequency="0.025 0.07" numOctaves="2" seed="4" result="n"><animate attributeName="baseFrequency" dur="0.8s" values="0.025 0.07;0.03 0.1;0.025 0.07" repeatCount="indefinite"></animate></feTurbulence><feDisplacementMap in="SourceGraphic" in2="n" scale="34" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap></filter><filter id="af-flameB" x="-40%" y="-40%" width="180%" height="180%"><feTurbulence type="fractalNoise" baseFrequency="0.035 0.09" numOctaves="2" seed="9" result="n"><animate attributeName="baseFrequency" dur="0.6s" values="0.035 0.09;0.03 0.13;0.035 0.09" repeatCount="indefinite"></animate></feTurbulence><feDisplacementMap in="SourceGraphic" in2="n" scale="24" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap></filter><filter id="af-flameC" x="-40%" y="-40%" width="180%" height="180%"><feTurbulence type="fractalNoise" baseFrequency="0.05 0.12" numOctaves="1" seed="2" result="n"><animate attributeName="baseFrequency" dur="0.45s" values="0.05 0.12;0.06 0.16;0.05 0.12" repeatCount="indefinite"></animate></feTurbulence><feDisplacementMap in="SourceGraphic" in2="n" scale="12" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap></filter><mask id="af-armmask" maskUnits="userSpaceOnUse" x="-400" y="-400" width="800" height="800"><rect x="-400" y="-400" width="800" height="800" fill="white"></rect><circle cx="0" cy="0" r="46" fill="black"></circle></mask><clipPath id="af-lclip"><path d="M-140 -400 L250 -400 L250 314 L236 352 L256 392 L242 430 L252 480 L-140 480 Z"></path></clipPath><clipPath id="af-rclip"><path d="M250 -400 L500 -400 L500 480 L252 480 L242 430 L256 392 L236 352 L250 314 Z"></path></clipPath>
      </defs>
      <g class="af-shake">
        <!-- wind lines streaming past -->
        <g class="farmer__lines" fill="none" stroke={INK} stroke-width="3" stroke-linecap="round">
          <path d="M236 112 H306"></path>
          <path d="M262 146 H336"></path>
          <path d="M250 286 H322"></path>
        </g>

        <!-- the rock, whole; and the two halves it breaks into -->
        <g class="af-rock"><path d="M24 468 L46 404 L34 374 L74 336 L112 322 L150 316 L204 318 L236 308 L272 330 L304 354 L296 394 L322 432 L330 468 Z" fill="#E6DECF" stroke="#15130F" stroke-width="5" stroke-linejoin="round"></path><path d="M236 308 L272 330 L304 354 L296 394 L322 432 L330 468 L252 468 L264 422 L242 376 Z" fill="url(#af-dots)" opacity="0.5"></path><path d="M150 316 L160 352 L146 384 M236 308 L228 342 L242 376 M74 336 L94 372 L82 410 M200 400 L214 430" fill="none" stroke="#15130F" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path></g>
        <g class="af-halves"><g transform="translate(110 468)"><g class="af-halfL"><g transform="translate(-110 -468)"><g clip-path="url(#af-lclip)"><path d="M24 468 L46 404 L34 374 L74 336 L112 322 L150 316 L204 318 L236 308 L272 330 L304 354 L296 394 L322 432 L330 468 Z" fill="#E6DECF" stroke="#15130F" stroke-width="5" stroke-linejoin="round"></path><path d="M236 308 L272 330 L304 354 L296 394 L322 432 L330 468 L252 468 L264 422 L242 376 Z" fill="url(#af-dots)" opacity="0.5"></path><path d="M150 316 L160 352 L146 384 M236 308 L228 342 L242 376 M74 336 L94 372 L82 410 M200 400 L214 430" fill="none" stroke="#15130F" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path></g></g></g></g><g transform="translate(300 468)"><g class="af-halfR"><g transform="translate(-300 -468)"><g clip-path="url(#af-rclip)"><path d="M24 468 L46 404 L34 374 L74 336 L112 322 L150 316 L204 318 L236 308 L272 330 L304 354 L296 394 L322 432 L330 468 Z" fill="#E6DECF" stroke="#15130F" stroke-width="5" stroke-linejoin="round"></path><path d="M236 308 L272 330 L304 354 L296 394 L322 432 L330 468 L252 468 L264 422 L242 376 Z" fill="url(#af-dots)" opacity="0.5"></path><path d="M150 316 L160 352 L146 384 M236 308 L228 342 L242 376 M74 336 L94 372 L82 410 M200 400 L214 430" fill="none" stroke="#15130F" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path></g></g></g></g></g>
        <path d="M-200 468 H340" stroke={INK} stroke-width="5"></path>
        <g transform="translate(244 316)"><path class="af-deb af-deb0" d="M0 0 l12 -7 l7 12 l-14 5 Z" fill="#E6DECF" stroke="#15130F" stroke-width="3"></path></g><g transform="translate(254 318)"><path class="af-deb af-deb1" d="M0 0 l12 -7 l7 12 l-14 5 Z" fill="#E6DECF" stroke="#15130F" stroke-width="3"></path></g><g transform="translate(238 324)"><path class="af-deb af-deb2" d="M0 0 l12 -7 l7 12 l-14 5 Z" fill="#E6DECF" stroke="#15130F" stroke-width="3"></path></g><g transform="translate(260 326)"><path class="af-deb af-deb3" d="M0 0 l12 -7 l7 12 l-14 5 Z" fill="#E6DECF" stroke="#15130F" stroke-width="3"></path></g>
        <path class="af-crackC" d="M300 352 L284 380 L298 404 L286 436 L294 468" fill="none" stroke="#15130F" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>

        <!-- the leap down: ground cracks, speed lines, after-images -->
        <path class="af-gcrack" d="M56 468 l-34 -2 l-18 10 M56 468 l30 -4 l22 8 M46 468 l-12 -8 M70 468 l10 -9" fill="none" stroke="#15130F" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
        <g class="af-speed"><path d="M-6 -40 V130" stroke="#15130F" stroke-width="4" stroke-linecap="round"></path><path d="M30 10 V230" stroke="#15130F" stroke-width="3" stroke-linecap="round"></path><path d="M70 -60 V90" stroke="#15130F" stroke-width="5" stroke-linecap="round"></path><path d="M110 40 V240" stroke="#15130F" stroke-width="3" stroke-linecap="round"></path><path d="M150 -20 V100" stroke="#15130F" stroke-width="4" stroke-linecap="round"></path><path d="M-20 140 V300" stroke="#15130F" stroke-width="3" stroke-linecap="round"></path><path d="M96 180 V320" stroke="#15130F" stroke-width="4" stroke-linecap="round"></path></g>
        <g class="af-gh af-gh0" transform="translate(-34 -60) scale(0.98)"><path d="M140 246 L138 310 L164 310 L166 246 Z M176 246 L178 310 L204 310 L202 246 Z M126 306 H166 V320 H122 Z M176 306 H214 V320 H180 Z M128 142 C120 190 122 230 132 252 L208 252 C218 230 220 190 212 142 Z" class="accent-fill"></path><path d="M132 140 C120 176 116 214 118 250 C146 256 166 236 194 238 C222 240 246 210 272 204 C290 200 304 182 318 170 C292 168 266 166 244 158 C228 152 216 146 208 140 Z" class="accent-fill"></path><g transform="translate(92 58) scale(0.55)"><path d="M92 150 C78 108 84 66 110 44 L104 14 L126 34 L134 0 L150 30 L170 6 L172 38 L196 22 L188 58 C204 84 206 122 188 150 Z" class="accent-fill"></path></g></g><g class="af-gh af-gh1" transform="translate(-52 40) scale(0.92)"><path d="M140 246 L138 310 L164 310 L166 246 Z M176 246 L178 310 L204 310 L202 246 Z M126 306 H166 V320 H122 Z M176 306 H214 V320 H180 Z M128 142 C120 190 122 230 132 252 L208 252 C218 230 220 190 212 142 Z" class="accent-fill"></path><path d="M132 140 C120 176 116 214 118 250 C146 256 166 236 194 238 C222 240 246 210 272 204 C290 200 304 182 318 170 C292 168 266 166 244 158 C228 152 216 146 208 140 Z" class="accent-fill"></path><g transform="translate(92 58) scale(0.55)"><path d="M92 150 C78 108 84 66 110 44 L104 14 L126 34 L134 0 L150 30 L170 6 L172 38 L196 22 L188 58 C204 84 206 122 188 150 Z" class="accent-fill"></path></g></g><g class="af-gh af-gh2" transform="translate(-66 130) scale(0.86)"><path d="M140 246 L138 310 L164 310 L166 246 Z M176 246 L178 310 L204 310 L202 246 Z M126 306 H166 V320 H122 Z M176 306 H214 V320 H180 Z M128 142 C120 190 122 230 132 252 L208 252 C218 230 220 190 212 142 Z" class="accent-fill"></path><path d="M132 140 C120 176 116 214 118 250 C146 256 166 236 194 238 C222 240 246 210 272 204 C290 200 304 182 318 170 C292 168 266 166 244 158 C228 152 216 146 208 140 Z" class="accent-fill"></path><g transform="translate(92 58) scale(0.55)"><path d="M92 150 C78 108 84 66 110 44 L104 14 L126 34 L134 0 L150 30 L170 6 L172 38 L196 22 L188 58 C204 84 206 122 188 150 Z" class="accent-fill"></path></g></g>

        <!-- lightning: strikes his raised hand, then the weapon appears in it (the short version's on the rock) -->
        <Lightning cls="af-bolt" from={[[150, -60], [40, -60], [250, -50], [-30, 40], [340, 70]]} to={[104, 258]} seed={7} />
        <Lightning cls="af-boltC" from={[[338, -36], [262, -60], [180, -60], [345, 60]]} to={[230, 55]} seed={5} forks={2} />

        <g class="af-move">
          <g class="af-aura"><g class="af-flick af-flick1" filter="url(#af-flameA)"><path d="M140 246 L138 310 L164 310 L166 246 Z M176 246 L178 310 L204 310 L202 246 Z M126 306 H166 V320 H122 Z M176 306 H214 V320 H180 Z" class="accent-fill accent-stroke" stroke-width="58" stroke-linejoin="round" opacity="0.28"></path></g><g class="af-flick af-flick2" filter="url(#af-flameB)"><path d="M140 246 L138 310 L164 310 L166 246 Z M176 246 L178 310 L204 310 L202 246 Z M126 306 H166 V320 H122 Z M176 306 H214 V320 H180 Z" class="accent-fill accent-stroke" stroke-width="30" stroke-linejoin="round" opacity="0.55"></path></g><g class="af-flick af-flick3" filter="url(#af-flameC)"><path d="M140 246 L138 310 L164 310 L166 246 Z M176 246 L178 310 L204 310 L202 246 Z M126 306 H166 V320 H122 Z M176 306 H214 V320 H180 Z" fill="none" stroke="#8FDDF2" stroke-width="9" stroke-linejoin="round" opacity="0.95"></path></g></g>
          <!-- legs and shoes, under the cape -->
          <path d="M140 246 L138 310 L164 310 L166 246 Z M176 246 L178 310 L204 310 L202 246 Z" fill={INK}></path>
          <path d="M126 306 H166 V320 H122 Z M176 306 H214 V320 H180 Z" fill={INK}></path>
          <g class="af-aura"><g transform="translate(136 300)"><path class="af-ptc af-p3 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(206 300)"><path class="af-ptc af-p4 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(150 318)"><path class="af-ptc af-p5 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(196 318)"><path class="af-ptc af-p0 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g></g>

          <!-- everything above the hips leans as one, pivoting at the hips -->
          <g transform="translate(170 252)"><g class="af-lean"><g transform="translate(-170 -252)">
            <g class="af-aura"><g class="af-flick af-flick1" filter="url(#af-flameA)"><g opacity="0.28"><path d="M128 142 C120 190 122 230 132 252 L208 252 C218 230 220 190 212 142 Z" class="accent-fill accent-stroke" stroke-width="58" stroke-linejoin="round"></path><path d="M132 140 C120 176 116 214 118 250 C146 256 166 236 194 238 C222 240 246 210 272 204 C290 200 304 182 318 170 C292 168 266 166 244 158 C228 152 216 146 208 140 Z" class="accent-fill accent-stroke" stroke-width="58" stroke-linejoin="round"></path><g transform="translate(92 58) scale(0.55)"><path d="M92 150 C78 108 84 66 110 44 L104 14 L126 34 L134 0 L150 30 L170 6 L172 38 L196 22 L188 58 C204 84 206 122 188 150 Z" class="accent-fill accent-stroke" stroke-width="105" stroke-linejoin="round"></path></g></g></g><g class="af-flick af-flick2" filter="url(#af-flameB)"><g opacity="0.55"><path d="M128 142 C120 190 122 230 132 252 L208 252 C218 230 220 190 212 142 Z" class="accent-fill accent-stroke" stroke-width="30" stroke-linejoin="round"></path><path d="M132 140 C120 176 116 214 118 250 C146 256 166 236 194 238 C222 240 246 210 272 204 C290 200 304 182 318 170 C292 168 266 166 244 158 C228 152 216 146 208 140 Z" class="accent-fill accent-stroke" stroke-width="30" stroke-linejoin="round"></path><g transform="translate(92 58) scale(0.55)"><path d="M92 150 C78 108 84 66 110 44 L104 14 L126 34 L134 0 L150 30 L170 6 L172 38 L196 22 L188 58 C204 84 206 122 188 150 Z" class="accent-fill accent-stroke" stroke-width="55" stroke-linejoin="round"></path></g></g></g><g class="af-flick af-flick3" filter="url(#af-flameC)"><g opacity="0.95"><path d="M128 142 C120 190 122 230 132 252 L208 252 C218 230 220 190 212 142 Z" fill="none" stroke="#8FDDF2" stroke-width="9" stroke-linejoin="round"></path><path d="M132 140 C120 176 116 214 118 250 C146 256 166 236 194 238 C222 240 246 210 272 204 C290 200 304 182 318 170 C292 168 266 166 244 158 C228 152 216 146 208 140 Z" fill="none" stroke="#8FDDF2" stroke-width="9" stroke-linejoin="round"></path><g transform="translate(92 58) scale(0.55)"><path d="M92 150 C78 108 84 66 110 44 L104 14 L126 34 L134 0 L150 30 L170 6 L172 38 L196 22 L188 58 C204 84 206 122 188 150 Z" fill="none" stroke="#8FDDF2" stroke-width="16" stroke-linejoin="round"></path></g></g></g><g transform="translate(92 58) scale(0.55)"><path class="af-hair" d="M92 150 C78 108 84 66 110 44 L104 14 L126 34 L134 0 L150 30 L170 6 L172 38 L196 22 L188 58 C204 84 206 122 188 150 Z" fill="none" stroke="#8FDDF2" stroke-width="14" stroke-linejoin="round"></path></g></g>
            <path d="M128 142 C120 190 122 230 132 252 L208 252 C218 230 220 190 212 142 Z" fill={INK}></path>

            <!-- arms crossed in front: from behind, only the left elbow pokes out past the cape -->
            <path class="af-armX" d="M130 166 C114 168 102 184 105 199 C108 210 122 211 130 204 Z" fill={INK}></path>

            <!-- the right arm: one limb from the shoulder, carrying whichever weapon he rolled; drawn before the cape, so the shoulder sits under it -->
            <g class="af-arm"><g transform="translate(204 150)"><g class="af-swoosh"><path d="M-131.8 -157.0 A205 205 0 0 1 204.2 17.9" fill="none" class="accent-stroke" stroke-width="16" stroke-linecap="round" opacity="0.55"></path><path d="M-105.4 -125.6 A164.0 164.0 0 0 1 163.4 14.3" fill="none" stroke="#15130F" stroke-width="3" stroke-linecap="round" stroke-dasharray="10 14" opacity="0.5"></path></g><g class="af-rig"><g transform="translate(0 -98) scale(0.8)"><g class="af-wpop" set:html={WEAPON_ART}></g></g><path d="M0 0 L0 -86" fill="none" stroke="#15130F" stroke-width="20" stroke-linecap="round"></path><circle cx="0" cy="-98" r="14" fill="#15130F"></circle><g class="af-spark accent-stroke" stroke-width="5" stroke-linecap="round"><path d="M-22 -112 L-38 -124"></path><path d="M22 -112 L38 -124"></path><path d="M-24 -84 L-42 -78"></path><path d="M24 -84 L42 -78"></path></g></g></g></g>

            <!-- the cape: calm (morphing), and wild while powered up -->
            <g class="af-capeCalm"><g class="farmer__cape">
              <path class="accent-fill" d={CAPE[0]} stroke={INK} stroke-width="4.5" stroke-linejoin="round">
                <animate attributeName="d" dur="2.6s" repeatCount="indefinite" calcMode="spline" keyTimes="0;0.3;0.5;0.8;1" keySplines={SPLINES} values={seq(CAPE)}></animate>
              </path>
              <path d={FOLD[0]} fill="none" stroke={INK} stroke-width="3" stroke-linecap="round" opacity="0.55">
                <animate attributeName="d" dur="2.6s" repeatCount="indefinite" calcMode="spline" keyTimes="0;0.3;0.5;0.8;1" keySplines={SPLINES} values={seq(FOLD)}></animate>
              </path>
            </g></g>
            <g class="af-capeWild"><g class="af-flap"><path class="accent-fill" d="M132 140 C120 176 116 214 118 250 C146 256 166 236 194 238 C222 240 246 210 272 204 C290 200 304 182 318 170 C292 168 266 166 244 158 C228 152 216 146 208 140 Z" stroke="#15130F" stroke-width="4.5" stroke-linejoin="round"></path><path d="M168 146 C160 184 160 214 166 240" fill="none" stroke="#15130F" stroke-width="3" stroke-linecap="round" opacity="0.55"></path></g></g>

            <!-- head: the same spiky hair as the hero and the wave in Contact -->
            <g transform="translate(92 58) scale(0.55)">
              <path d="M92 150 C78 108 84 66 110 44 L104 14 L126 34 L134 0 L150 30 L170 6 L172 38 L196 22 L188 58 C204 84 206 122 188 150 Z" fill={INK}></path>
              <path d="M94 104 C86 102 82 114 88 124 C92 130 98 128 98 122" fill={LIGHT} stroke={INK} stroke-width="5"></path>
              <path d="M116 56 C102 76 100 102 104 128" fill="none" stroke={LIGHT} stroke-width="6" stroke-linecap="round"></path>
            </g>
            <!-- cape clasp at the shoulders -->
            <path d="M130 142 C150 134 190 134 210 142" fill="none" stroke={INK} stroke-width="7" stroke-linecap="round"></path>

            <!-- ...and the same arm again over the cape, masked around the shoulder; shown only for the strike, so the forearm comes out from under the cape instead of sweeping through it -->
            <g class="af-armFront"><g transform="translate(204 150)" mask="url(#af-armmask)"><g class="af-rig"><g transform="translate(0 -98) scale(0.8)"><g class="af-wpop" set:html={WEAPON_ART}></g></g><path d="M0 0 L0 -86" fill="none" stroke="#15130F" stroke-width="20" stroke-linecap="round"></path><circle cx="0" cy="-98" r="14" fill="#15130F"></circle><g class="af-spark accent-stroke" stroke-width="5" stroke-linecap="round"><path d="M-22 -112 L-38 -124"></path><path d="M22 -112 L38 -124"></path><path d="M-24 -84 L-42 -78"></path><path d="M24 -84 L42 -78"></path></g></g></g></g>
            <g class="af-aura"><g transform="translate(166 56)"><path class="af-ptc af-p0 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(186 60)"><path class="af-ptc af-p1 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(158 74)"><path class="af-ptc af-p2 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(204 80)"><path class="af-ptc af-p3 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(128 146)"><path class="af-ptc af-p4 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(212 146)"><path class="af-ptc af-p5 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(316 204)"><path class="af-ptc af-p0 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(276 232)"><path class="af-ptc af-p1 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(230 250)"><path class="af-ptc af-p2 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(124 262)"><path class="af-ptc af-p3 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(118 200)"><path class="af-ptc af-p4 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g><g transform="translate(222 180)"><path class="af-ptc af-p5 accent-stroke" d="M0 -6 L3.5 0 L0 6 L-3.5 0 Z" fill="#8FDDF2" stroke-width="1.5"></path></g></g>
          </g></g></g>
