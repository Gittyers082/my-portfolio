---
<div class="desk" data-notebook>
  <div class="desk__stage" data-stage>
    <button class="gm" type="button" aria-label="Turn the page of my grimoire" data-book>
      <span class="gm__shadow" aria-hidden="true"></span>
      <span class="gm__cover" aria-hidden="true"></span>
      <span class="gm__edge gm__edge--b" aria-hidden="true"></span><span class="gm__edge gm__edge--t" aria-hidden="true"></span>
      <span class="gm__edge gm__edge--l" aria-hidden="true"></span><span class="gm__edge gm__edge--r" aria-hidden="true"></span>
      <span class="gm__block" aria-hidden="true">
        <span class="gm__page gm__page--l" data-page-l set:html={codeLeft(3, false)}></span>
        <span class="gm__page gm__page--r" data-page-r set:html={codeRight(FIX_CHARS).html}></span>
        <span class="gm__gutter"></span>
        <span class="gm__leaf" data-leaf>
          <span class="gm__page gm__face gm__face--front" data-face-front></span>
          <span class="gm__page gm__face gm__face--back" data-face-back></span>
          <span class="gm__shade" data-leaf-shade></span>
        </span>
      </span>
    </button>
    <svg class="gm-puddle" viewBox="0 0 300 120" aria-hidden="true" data-puddle>
      <path d={PUDDLE} fill="#2A1D14"></path>
      <circle cx="44" cy="108" r="5" fill="#2A1D14"></circle><circle cx="140" cy="108" r="3.5" fill="#2A1D14"></circle><circle cx="96" cy="20" r="3" fill="#2A1D14"></circle>
    </svg>
    <div class="gm-fx" aria-hidden="true" data-fx></div>
    <button class="gm-mug" type="button" aria-label="Knock the coffee over" data-mug set:html={MUG}></button>
    <button class="gm-quill" type="button" aria-label="Fix it with the quill" data-quill set:html={QUILL}></button>
  </div>
  <p class="sr-only" aria-live="polite" data-gm-live></p>
</div>
