---
/** Line icons for the Character file's chapter headers, drawn to match StackIcon and LoreIcon. */
interface Props { name: 'cert' | 'merlin' }
const { name } = Astro.props;
---
<span class="stack-icon" aria-hidden="true">
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" stroke-linejoin="miter">
    {name === 'cert' && (
      <>
        <rect x="4" y="5" width="24" height="16"></rect><circle cx="16" cy="13" r="3.6"></circle><path d="M13.4 15.8 L12 28 L16 25.2 L20 28 L18.6 15.8"></path>
      </>
    )}
    {name === 'merlin' && (
      <>
        <path d="M16 3 C18 8 23 10 23 17 C23 22 20 27 16 27 C12 27 9 22 9 17 C9 13 11 11 12 8 C13 11 14 12 15.5 12 C15 9 15 6 16 3 Z"></path>
        <path d="M16 27 C14 27 13 25 13 23 C13 20 16 18 16 16 C17 19 19 20 19 23 C19 25 18 27 16 27"></path>
      </>
    )}
  </svg>
</span>
