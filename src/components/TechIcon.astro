---
/**
 * A small monochrome logo for a tool or language (see src/data/techIcons.ts).
 * Logos Simple Icons doesn't carry get a lettered tile so the row still lines up.
 * Names not listed there render nothing.
 */
import { techIcon } from '../data/techIcons';

interface Props { name: string; size?: 'sm' | 'md' | 'lg' }
const { name, size = 'md' } = Astro.props;

const found = techIcon(name);
const icon = found && 'path' in found ? found : null;
const tile = found && 'tile' in found ? found.tile : null;
---
{icon && (
  <svg class:list={['tech-icon', `tech-icon--${size}`]} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icon.path}></path></svg>
)}
{tile && <span class:list={['tech-icon', 'tech-icon--tile', `tech-icon--${size}`, { 'tech-icon--long': tile.length > 2 }]} aria-hidden="true">{tile}</span>}
