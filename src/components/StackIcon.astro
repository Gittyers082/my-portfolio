---
/** Hand-drawn line icons for the Stack areas (original, not brand logos; see src/data/stackIcons.ts). */
import type { StackId } from '../data/profile';
import { STACK_ICONS } from '../data/stackIcons';
interface Props { name: StackId }
const { name } = Astro.props;
---
<span class="stack-icon" aria-hidden="true">
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" stroke-linejoin="miter" set:html={STACK_ICONS[name]}></svg>
</span>
