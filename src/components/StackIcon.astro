---
/** Hand-drawn line icons for the Stack areas (original, not brand logos). */
import type { StackId } from '../data/profile';
interface Props { name: StackId }
const { name } = Astro.props;
---
<span class="stack-icon" aria-hidden="true">
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" stroke-linejoin="miter">
    {name === 'languages' && (
      <>
        <path d="M10 9 L4 16 L10 23"></path><path d="M22 9 L28 16 L22 23"></path><path d="M18.5 6 L13.5 26"></path>
      </>
    )}
    {name === 'web' && (
      <>
        <rect x="3" y="6" width="26" height="20"></rect><path d="M3 11.5 H29"></path><path d="M8 17 H17"></path><path d="M8 21.5 H22"></path>
      </>
    )}
    {name === 'tools' && (
      <>
        <circle cx="9" cy="7" r="3"></circle><circle cx="9" cy="25" r="3"></circle><circle cx="23" cy="11" r="3"></circle>
        <path d="M9 10 V22"></path><path d="M23 14 C23 20 15 18.5 11 22.5"></path>
      </>
    )}
    {name === 'backend' && (
      <>
        <rect x="4" y="5" width="24" height="9"></rect><rect x="4" y="18" width="24" height="9"></rect><path d="M8.5 9.5 H10"></path><path d="M8.5 22.5 H10"></path><path d="M15 9.5 H23"></path><path d="M15 22.5 H23"></path>
      </>
    )}
    {name === 'data' && (
      <>
        <ellipse cx="16" cy="7" rx="11" ry="3.5"></ellipse><path d="M5 7 V25 C5 27 10 28.5 16 28.5 C22 28.5 27 27 27 25 V7"></path><path d="M5 16 C5 18 10 19.5 16 19.5 C22 19.5 27 18 27 16"></path>
      </>
    )}
    {name === 'design' && (
      <>
        <path d="M16 3 L25 14 L16 29 L7 14 Z"></path><path d="M16 29 V17"></path><circle cx="16" cy="14.5" r="2.4"></circle>
      </>
    )}
    {name === 'ai' && (
      <>
        <circle cx="16" cy="16" r="3.2"></circle><circle cx="6" cy="7" r="2.6"></circle><circle cx="26" cy="7" r="2.6"></circle>
        <circle cx="6" cy="25" r="2.6"></circle><circle cx="26" cy="25" r="2.6"></circle>
        <path d="M8 9 L13.6 13.8"></path><path d="M24 9 L18.4 13.8"></path><path d="M8 23 L13.6 18.2"></path><path d="M24 23 L18.4 18.2"></path>
      </>
    )}
  </svg>
</span>
