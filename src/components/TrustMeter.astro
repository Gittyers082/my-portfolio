---
/**
 * Exploration meter: how much of the site the visitor has found. It rises as
 * they explore (opening chapters, picking episodes, the demo, the photo, the
 * notebook, the coffee, the pencil, copying the email), and hints at what's
 * left. Shows only after the hero has scrolled away. Needs JavaScript, so it
 * starts hidden and features.ts reveals it.
 * (Internal names still say "trust": that's just the code's history.)
 */
---
<aside class="trust" aria-label="Exploration progress" hidden data-trust>
  <div class="trust__top">
    <span class="trust__label">Explored</span>
    <span class="trust__value" data-trust-value>0%</span>
  </div>
  <div class="trust__bar" aria-hidden="true">
    {Array.from({ length: 10 }, () => <span class="trust__seg"></span>)}
  </div>
  <span class="trust__rank" data-trust-rank>Next: open a chapter</span>
</aside>
