---
/**
 * The Character file: four chapters, one open at a time.
 * Built on native <details name="…"> so it works with no JavaScript;
 * site.ts closes the others in browsers that don't support `name` yet.
 */
import { skills, kit, projects } from '../data/profile';

const chapters = [
  { id: 'stack', title: 'Stack', teaser: 'Languages, tools and what I’m learning next', count: `${skills.length} skills`, open: true },
  { id: 'projects', title: 'Projects', teaser: 'Everything I’ve shipped, big and small', count: `${projects.length} builds` },
  { id: 'writing', title: 'Writing', teaser: 'Lore, worldbuilding and power systems', count: 'Side quest' },
  { id: 'training', title: 'Training', teaser: 'School, courses and certificates', count: 'SLU · 3rd year' },
];
const segments = Array.from({ length: 10 }, (_, i) => i);
---
<section id="file" class="section" aria-labelledby="file-h">
  <div class="section__head">
    <h2 id="file-h" class="display h-section" data-reveal>Character file</h2>
    <p class="lede" data-reveal style="--d:1">My stack, projects, writing and training. Open any chapter.</p>
  </div>

  <div class="cf">
    {chapters.map((ch, i) => (
      <details class="cf__item" name="character-file" open={ch.open} data-reveal style={`--d:${i + 2}`}>
        <summary class="cf__head">
          <span class="display cf__title">{ch.title}</span>
          <span class="cf__teaser">{ch.teaser}</span>
          <span class="cf__count">{ch.count}</span>
          <span class="cf__icon" aria-hidden="true">
            <svg viewBox="0 0 28 28"><path d="M4 14 H24" stroke="currentColor" stroke-width="4"></path><path class="cf__icon-v" d="M14 4 V24" stroke="currentColor" stroke-width="4"></path></svg>
          </span>
        </summary>

        {ch.id === 'stack' && (
          <div class="cf__body grid12">
            <div class="stats">
              <p class="stats__note">Power levels <span class="placeholder">[set your own; these are placeholders]</span></p>
              {skills.map((s) => (
                <div class="stat">
                  <span class="stat__name">{s.name}</span>
                  <div>
                    <div class="stat__bar" role="img" aria-label={`Level ${s.level} of 10`}>
                      {segments.map((n) => (
                        <span class:list={['stat__seg', { 'stat__seg--on': n < s.level }]} style={`--n:${n}`}></span>
                      ))}
                    </div>
                    <p class:list={['stat__desc', { placeholder: s.placeholderNote }]}>{s.note}</p>
                  </div>
                </div>
              ))}
            </div>
            <dl class="kit">
              {kit.map((k) => (
                <div><dt>{k.label}</dt><dd>{k.known} {k.todo && <span class="placeholder">{k.todo}</span>}</dd></div>
              ))}
            </dl>
          </div>
        )}

        {ch.id === 'projects' && (
          <div class="cf__body">
            <ul class="cf-list">
              {projects.map((p) => (
                <li>
                  <span class:list={['cf-list__name', { placeholder: p.placeholder }]}>{p.name}</span>
                  <span class:list={['cf-list__line', { placeholder: p.placeholder }]}>{p.line}</span>
                  {p.href ? <a href={p.href}>Case study</a> : <span class="placeholder">[link]</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        {ch.id === 'writing' && (
          <div class="cf__body cf-two">
            <p>Outside code, I write lore, original characters, worldbuilding and power systems for clients on Fiverr. <span class="placeholder">[Keep or remove this chapter]</span></p>
            <p><span class="placeholder">[Fiverr profile link]</span><br /><span class="placeholder">[Sample world or excerpt]</span></p>
          </div>
        )}

        {ch.id === 'training' && (
          <div class="cf__body cf-two">
            <p><b>BS Information Technology</b><br />Saint Louis University · 3rd year · <span class="placeholder">[expected graduation]</span></p>
            <p><b class="placeholder">[Courses, certificates or bootcamps]</b><br /><span class="placeholder">[Details]</span></p>
          </div>
        )}
      </details>
    ))}
  </div>
</section>
