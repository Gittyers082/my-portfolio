---
/**
 * The Character file: the climb. Stack, Training and Writing on the way up,
 * Projects at the top (open by default: it's the peak of the page).
 * One chapter open at a time, built on native <details name="…"> so it works
 * without JavaScript; site.ts covers browsers without `name` support.
 *
 * Headers show live counts (area icons, a mini progress bar, lore symbols); on
 * desktop a closed chapter peeks at what's inside on hover; the first time a
 * chapter is opened it gets an "Opened" stamp (site.ts).
 *
 * Inside Projects, the picked episode "pops out" into a big panel. Without
 * JavaScript every episode panel is simply shown, one after another.
 *
 * Certified sits just before Projects: the trophy wall (CertWall.astro, certs.ts).
 */
import Arrow from './Arrow.astro';
import StackIcon from './StackIcon.astro';
import TechIcon from './TechIcon.astro';
import EpisodeArt from './EpisodeArt.astro';
import KadugoDemo from './KadugoDemo.astro';
import MerlinDemo from './MerlinDemo.astro';
import ThriftbiteDemo from './ThriftbiteDemo.astro';
import LoreIcon from './LoreIcon.astro';
import CertWall from './CertWall.astro';
import ChapterIcon from './ChapterIcon.astro';
import PlanningSketch from './PlanningSketch.astro';
import OtherverseMap from './OtherverseMap.astro';
import { certs } from '../data/certifications';
import { stack, episodes, profile, lore, sealedFiles, course, missions, selfTraining } from '../data/profile';

const loreKind = { universe: 'Universe', power: 'Power system', oc: 'Character', faction: 'Faction', artifact: 'Artifact' } as const;
// the archive's first year, from the files themselves ("Since 2021" → 2021)
const loreSince = Math.min(...lore.map((l) => Number(l.year?.match(/\d{4}/)?.[0] ?? Infinity)));
// sealed files: a few blacked-out lines of uneven length, the same every build
const sealBars = (n: number, seed: number) => Array.from({ length: n }, (_, k) => 62 + ((seed * 37 + k * 23) % 38));

const statusLabel = { cleared: 'Cleared', active: 'In Progress', locked: 'Locked' } as const;

// Quest counts for the Academy progress bar
const allQuests = course.terms.flatMap((t) => t.quests.map(() => t.status));
const cleared = allQuests.filter((st) => st === 'cleared').length;
const active = allQuests.filter((st) => st === 'active').length;

const chapters = [
  { id: 'stack', title: 'Stack', teaser: 'Languages, tools and what I’m learning next', count: `${stack.length} Areas` },
  { id: 'training', title: 'Training', teaser: 'School, clubs, events and self-training', count: 'Training arc' },
  { id: 'writing', title: 'Writing', teaser: 'Lore, worldbuilding and power systems', count: 'Side Quest' },
  { id: 'certs', title: 'Certified', teaser: 'Courses cleared. Receipts on the wall.', count: `${certs.length} Earned` },
  { id: 'projects', title: 'Projects', teaser: 'The main event. What I’ve built so far.', count: `${episodes.length} Episodes`, open: true },
];
const segments = Array.from({ length: 10 }, (_, i) => i);
// header extras: live counts (always shown) and a hover peek (desktop) for the closed chapters
const activeQuests = course.terms.filter((t) => t.status === 'active').flatMap((t) => t.quests.map((q) => q.name));
const peekLogos = ['Java', 'Python', 'TypeScript', 'React', 'Astro', 'Spring Boot', 'Node.js', 'PostgreSQL', 'Docker', 'Git'];
---
<section id="file" class="section" aria-labelledby="file-h">
  <div class="section__head">
    <h2 id="file-h" class="display h-section glitch" data-text="Character file" data-reveal>Character file</h2>
    <p class="lede" data-reveal style="--d:1">Stack, training and side quests on the way up. Projects at the top.</p>
  </div>

  <div class="cf">
    {chapters.map((ch, i) => (
      <details class:list={['cf__item', `cf__item--${ch.id}`]} name="character-file" open={ch.open} id={ch.id === 'projects' ? 'projects' : undefined} data-chapter={ch.id} data-reveal style={`--d:${i + 2}`}>
        <summary class="cf__head">
          <span class="display cf__title">{ch.title}</span>
          <span class="cf__teaser">{ch.teaser}</span>
          <span class="cf__count">
            {ch.id === 'stack' && <span class="cf__live"><span class="cf__mini">{stack.map((a) => <StackIcon name={a.id} />)}</span><span class="cf__live-text">{ch.count}</span></span>}
            {ch.id === 'training' && (
              <span class="cf__live cf__live--bar">
                <span class="cf__minibar" aria-hidden="true">{allQuests.map((st) => <span class:list={['cf__minibar-seg', `cf__minibar-seg--${st}`]}></span>)}</span>
                <span class="cf__live-text">{cleared} Cleared · {active} In Progress</span>
              </span>
            )}
            {ch.id === 'writing' && <span class="cf__live"><span class="cf__mini">{lore.map((l) => <LoreIcon name={l.kind} />)}</span><span class="cf__live-text">{ch.count}</span></span>}
            {ch.id === 'certs' && <span class="cf__live"><span class="cf__mini"><ChapterIcon name="cert" /></span><span class="cf__live-text">{ch.count}</span></span>}
            {ch.id === 'projects' && <span class="cf__live"><span class="cf__mini"><ChapterIcon name="merlin" /></span><span class="cf__live-text">{ch.count}</span></span>}
          </span>
          <span class="cf__stamp" aria-hidden="true">Opened</span>
          <span class="cf__icon" aria-hidden="true">
            <svg viewBox="0 0 28 28"><path d="M4 14 H24" stroke="currentColor" stroke-width="4"></path><path class="cf__icon-v" d="M14 4 V24" stroke="currentColor" stroke-width="4"></path></svg>
          </span>
          {ch.id !== 'projects' && (
            <span class="cf__peek" aria-hidden="true">
              <span class="cf__peek-label">Inside</span>
              {ch.id === 'stack' && <span class="cf__peek-logos">{peekLogos.map((n) => <TechIcon name={n} size="sm" />)}<span class="cf__peek-more">and more</span></span>}
              {ch.id === 'training' && <span class="cf__peek-list">{activeQuests.map((q) => <span class="cf__peek-chip">{q}</span>)}</span>}
              {ch.id === 'writing' && <span class="cf__peek-list">{lore.map((l) => <span class="cf__peek-chip"><LoreIcon name={l.kind} />{l.name}</span>)}</span>}
              {ch.id === 'certs' && <span class="cf__peek-list">{[...certs].reverse().slice(0, 3).map((c) => <span class="cf__peek-chip">{c.title}</span>)}</span>}
            </span>
          )}
        </summary>

        {ch.id === 'stack' && (
          <div class="cf__body">
            <p class="stats__note">Bars show how confident I am, out of 10.</p>
            <div class="areas">
              {stack.map((area, i) => (
                <div class:list={['area', `area--${area.id}`]} style={`--i:${i}`}>
                  <div class="area__head">
                    <StackIcon name={area.id} />
                    <div>
                      <p class="area__title">{area.title}</p>
                      <p class="area__line">{area.line}</p>
                    </div>
                  </div>
                  {area.skills?.map((s) => (
                    <div class="stat">
                      <span class="stat__name stat__name--tech"><TechIcon name={s.name} />{s.name}</span>
                      <div>
                        <div class="stat__meter">
                          <div class="stat__bar" role="img" aria-label={`Level ${s.level} of 10`}>
                            {segments.map((n) => (
                              <span class:list={['stat__seg', { 'stat__seg--on': n < s.level }]} style={`--n:${n}`}></span>
                            ))}
                          </div>
                          <span class="stat__num" aria-hidden="true"><b data-count={s.level}>{s.level}</b>/10</span>
                        </div>
                        <p class:list={['stat__desc', { placeholder: s.placeholderNote }]}>{s.note}</p>
                      </div>
                    </div>
                  ))}
                  {area.items && (
                    <ul class="area__items">
                      {area.items.map((it) => <li class:list={['tech', { placeholder: it.placeholder }]}><TechIcon name={it.text} />{it.text}</li>)}
                    </ul>
                  )}
                  {area.id === 'design' && <PlanningSketch />}
                  {area.groups && (
                    <dl class="area__groups">
                      {area.groups.map((g) => (
                        <div class:list={['area__group', { 'area__group--logos': g.iconsOnly }]}>
                          <dt>{g.label}</dt>
                          {g.iconsOnly ? (
                            <dd class="logo-row">
                              {g.items.map((t) => (
                                <span class="logo-tile" title={t}><TechIcon name={t} /><span class="sr-only">{t}</span></span>
                              ))}
                            </dd>
                          ) : (
                            <dd>{g.items.map((t) => <span class="tech tech--sm"><TechIcon name={t} size="sm" />{t}</span>)}</dd>
                          )}
                        </div>
                      ))}
                    </dl>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {ch.id === 'training' && (
          <div class="cf__body train">
            <section class="train__block" style="--i:0" aria-labelledby="train-academy">
              <h3 id="train-academy" class="train__h">Academy</h3>
              <details class="course" data-glide>
                <summary class="course__head">
                  <span class="course__title">
                    <span class="course__degree">{course.degree}</span>
                    <span class="course__school">{course.school} · {course.year}</span>
                  </span>
                  <span class="course__progress">
                    <span class="course__count"><b>{cleared}</b> Cleared · <b>{active}</b> In Progress</span>
                    <span class="course__bar" aria-hidden="true">
                      {allQuests.map((st) => <span class:list={['course__seg', `course__seg--${st}`]}></span>)}
                    </span>
                  </span>
                  <span class="course__toggle" aria-hidden="true">
                    <span class="course__toggle-label">
                      <span class="course__toggle-text course__toggle-text--open">Open the quest board</span>
                      <span class="course__toggle-text course__toggle-text--close">Close</span>
                    </span>
                    <svg viewBox="0 0 28 28"><path d="M4 14 H24" stroke="currentColor" stroke-width="4"></path><path class="course__toggle-v" d="M14 4 V24" stroke="currentColor" stroke-width="4"></path></svg>
                  </span>
                </summary>
                <ol class="quests" role="list">
                  {course.terms.map((t, ti) => (
                    <li class:list={['term', `term--${t.status}`]} style={`--t:${ti}`}>
                      <div class="term__head">
                        <span class="term__label">{t.label}</span>
                        <span class:list={['term__status', `term__status--${t.status}`]}>{statusLabel[t.status]}</span>
                      </div>
                      {t.quests.length > 0 ? (
                        <ul class="term__quests" role="list">
                          {t.quests.map((q) => {
                            const head = (
                              <>
                                <span class="quest__mark" aria-hidden="true">
                                  {t.status === 'cleared'
                                    ? <svg viewBox="0 0 16 16"><path d="M2.5 8.5 L6.5 12 L13.5 4" fill="none" stroke="currentColor" stroke-width="2.4"></path></svg>
                                    : <span class="quest__dot"></span>}
                                </span>
                                <span class="quest__title"><span class="quest__name">{q.name}</span>{q.tag && <span class="quest__tag">{q.tag}</span>}</span>
                                <span class="sr-only"> ({statusLabel[t.status]})</span>
                              </>
                            );
                            // a quest with a note opens to show it; the rest are a plain row
                            return q.learned ? (
                              <li class:list={['quest', 'quest--open-able', `quest--${t.status}`]}>
                                <details class="quest__details" data-glide>
                                  <summary class="quest__head">
                                    {head}
                                    <svg class="quest__plus" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8 H14" stroke="currentColor" stroke-width="2.4"></path><path class="quest__plus-v" d="M8 2 V14" stroke="currentColor" stroke-width="2.4"></path></svg>
                                  </summary>
                                  <div class="quest__learned">
                                    <p>{q.learned}</p>
                                    {q.link && <a class="quest__link" href={q.link.href}>{q.link.label}</a>}
                                  </div>
                                </details>
                              </li>
                            ) : (
                              <li class:list={['quest', `quest--${t.status}`]}>
                                <div class="quest__head">{head}</div>
                              </li>
                            );
                          })}
                        </ul>
                      ) : (
                        <p class="term__locked">Unlocks next semester.</p>
                      )}
                    </li>
                  ))}
                </ol>
              </details>
            </section>

            <section class="train__block" style="--i:1" aria-labelledby="train-missions">
              <h3 id="train-missions" class="train__h">Clubs and events</h3>
              <ul class="missions" role="list">
                {missions.map((m) => (
                  <li class="mission">
                    <div class="mission__top">
                      <span class="mission__kind">{m.kind}</span>
                      <span class:list={['mission__when', { 'mission__when--now': m.current }]}>{m.when}</span>
                    </div>
                    <h4 class="mission__title">{m.title}</h4>
                    <p class="mission__role">{m.role}</p>
                    <p class="mission__note">{m.note}</p>
                  </li>
                ))}
              </ul>
            </section>

            <section class="train__block" style="--i:2" aria-labelledby="train-self">
              <h3 id="train-self" class="train__h">Self-training</h3>
              <ul class="selftrain" role="list">
                {selfTraining.map((st) => (
                  <li class="selftrain__item">
                    <h4 class="selftrain__title">{st.title}</h4>
                    <p class="selftrain__note">{st.note}</p>
                  </li>
                ))}
              </ul>
            </section>
          </div>
        )}

        {ch.id === 'writing' && (
          <div class="cf__body lore">
            <div class="lore__top">
              <div class="lore__lead">
                <p class="lore__intro">Outside code, I build worlds. This is a piece of the Otherverse, the universe I’ve been writing: the world, its rarest power, and one of its characters. I also write lore like this for clients.</p>
                <ul class="lore__stats" role="list">
                  <li><span>Archive since</span><b>{loreSince}</b></li>
                  <li><span>Files</span><b>{lore.length + sealedFiles.length}</b></li>
                  <li><span>Declassified</span><b><span data-lore-count>{lore.length}</span>/{lore.length}</b></li>
                  <li><span>Sealed</span><b>{sealedFiles.length}</b></li>
                  <li><span>Commissions</span><b class="lore__open">Open</b></li>
                </ul>
              </div>
              <OtherverseMap />
            </div>

            <ul class="lore__grid" role="list">
              {lore.map((w, i) => (
                <li class:list={['dossier', `dossier--${w.kind}`]} style={`--i:${i}`} data-dossier>
                  <div class="dossier__top">
                    <LoreIcon name={w.kind} />
                    <span class="dossier__kind">{loreKind[w.kind]}</span>
                    {w.year && <span class:list={['dossier__year', { placeholder: w.placeholder }]}>{w.year}</span>}
                  </div>
                  <div class="dossier__head">
                    <div>
                      <h3 class:list={['dossier__name', { placeholder: w.placeholder }]}>{w.name}</h3>
                      {w.epithet && <p class="dossier__epithet">{w.epithet}</p>}
                    </div>
                    <span class="dossier__stamp" aria-hidden="true"><span class="dossier__stamp-c">Classified</span><span class="dossier__stamp-d">Declassified</span></span>
                  </div>
                  <p class:list={['dossier__hook', { placeholder: w.placeholder }]}><span class="redact">{w.hook}</span></p>
                  {w.quote && (
                    <blockquote class="dossier__quote"><p><span class="sr-only">“{w.quote}”</span><span class="redact" aria-hidden="true" data-quote-type>“{w.quote}”</span></p><footer>{w.name}</footer></blockquote>
                  )}
                  <dl class="dossier__specs">
                    {w.specs.map((sp) => (
                      <div class="dossier__spec">
                        <dt>{sp.label}</dt>
                        <dd class:list={{ placeholder: w.placeholder }}><span class="redact">{sp.value}</span></dd>
                      </div>
                    ))}
                  </dl>
                  {w.link && (
                    <a class="dossier__link" href={w.link} target="_blank" rel="noopener">Read it<span class="sr-only"> ({w.name})</span></a>
                  )}
                </li>
              ))}
              {sealedFiles.map((f, i) => (
                <li class="dossier dossier--sealed" style={`--i:${lore.length + i}`} data-sealed>
                  <span class="sr-only">Sealed file: {loreKind[f.kind].toLowerCase()}, not declassified yet.</span>
                  <div class="dossier__top" aria-hidden="true">
                    <LoreIcon name={f.kind} />
                    <span class="dossier__kind">{loreKind[f.kind]}</span>
                    <span class="dossier__year">20??</span>
                  </div>
                  <div class="dossier__head" aria-hidden="true">
                    <span class="seal__name" style={`width:${sealBars(1, i)[0]}%`}></span>
                    <span class="dossier__stamp dossier__stamp--sealed">Sealed</span>
                  </div>
                  <div class="seal__lines" aria-hidden="true">
                    {sealBars(3, i + 1).map((w, k) => <span class="seal__bar" style={`width:${k === 2 ? w - 30 : w}%`}></span>)}
                  </div>
                  <p class="seal__note" aria-hidden="true">Not declassified yet.</p>
                </li>
              ))}
            </ul>

            <a class="commission" style={`--i:${lore.length + sealedFiles.length}`} href={profile.fiverr} target="_blank" rel="noopener">
              <span class="commission__text">
                <span class="commission__kicker">Commissions open</span>
                <span class="commission__title">Need a world built?</span>
                <span class="commission__list">Lore · OCs · Worldbuilding · Power systems</span>
              </span>
              <span class="commission__cta">Commission me on Fiverr <Arrow /></span>
            </a>
          </div>
        )}

        {ch.id === 'projects' && (
          <div class="cf__body episodes" data-episodes>
            <div class="eps">
              <div class="pop">
                <div class="pop__shadow" aria-hidden="true"></div>
                <div class="pop__panel">
                  {episodes.map((ep, j) => (
                    <div class:list={['pop__ep', { 'is-active': j === 0 }]} data-episode={ep.id} id={`episode-${ep.id}`} role="region" aria-label={ep.title}>
                      {ep.id === 'merlin' ? <MerlinDemo /> : ep.id === 'thriftbite' ? <ThriftbiteDemo /> : <KadugoDemo />}
                      <article class="pop__info">
                        <div class="pop__text">
                          <h3 class="display pop__title">{ep.title}</h3>
                          <p class="pop__meta">{ep.meta}</p>
                          <p class="lede pop__summary">{ep.summary}</p>
                          <details class="pop__more" data-glide>
                            <summary class="pop__more-btn">
                              <span class="pop__more-open">Read more</span><span class="pop__more-close">Show less</span>
                              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8 H14" stroke="currentColor" stroke-width="2.4"></path><path class="pop__more-v" d="M8 2 V14" stroke="currentColor" stroke-width="2.4"></path></svg>
                            </summary>
                            <dl class="work__facts">
                              {ep.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
                            </dl>
                          </details>
                        </div>
                        {ep.links.length > 0 && (
                          <div class="pop__links">
                            {ep.links.map((l, k) => (
                              <a class:list={['pop__cta', { 'pop__cta--main': k === 0 }]} href={l.href} target="_blank" rel="noopener">
                                <span>{l.label}</span>
                                <Arrow />
                              </a>
                            ))}
                          </div>
                        )}
                      </article>
                    </div>
                  ))}
                </div>
              </div>

              <div class="picker" role="group" aria-label="Episodes" hidden>
                <p class="picker__head"><span>Episodes</span><b>{episodes.length}</b></p>
                {episodes.map((ep, j) => (
                  <button type="button" class="picker__btn" data-pick={ep.id} aria-controls={`episode-${ep.id}`} aria-pressed={j === 0 ? 'true' : 'false'}>
                    <span class="picker__thumb"><span class="picker__zoom"><EpisodeArt id={ep.id} title={ep.title} uid={`thumb-${ep.id}`} /></span></span>
                    <span class="picker__text">
                      <span class="picker__num">Episode {j + 1}</span>
                      <span class="picker__name">{ep.title}</span>
                    </span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        )}
        {ch.id === 'certs' && (
          <div class="cf__body">
            <CertWall />
          </div>
        )}
      </details>
    ))}
  </div>
</section>
