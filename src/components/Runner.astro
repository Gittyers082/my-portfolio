---
/**
 * dodge.exe: a Game Boy style runner. It plays itself until you click; then you jump the bugs.
 * Used in the footer and on the 404 page. Logic and drawing: src/scripts/dodge.ts, pixel art: dodge-sprites.ts.
 */
interface Props { caption?: string }
const { caption = 'Shipping, one bug at a time.' } = Astro.props;
---
<figure class="runner" data-runner>
  <div class="runner__bar" aria-hidden="true"><span>dodge.exe</span><span class="runner__score">bugs dodged <b data-runner-score>000</b></span></div>
  <button class="runner__screen" type="button" aria-label="dodge.exe: play the game. Space or tap to jump" data-runner-screen>
    <canvas width="256" height="96" data-runner-canvas></canvas>
  </button>
  <figcaption class="runner__cap">{caption} <span class="runner__hint">Click the screen to play; tap or Space to jump.</span></figcaption>
</figure>
