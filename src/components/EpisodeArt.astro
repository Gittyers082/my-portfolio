---
/**
 * Episode posters for the picker thumbnails, one per project, each drawn in
 * that project's own colours (fixed in both themes). Pure markup + SVG, so it scales to the thumbnail
 * (CSS zoom) and to the popped-out panel without separate assets.
 */
import type { Episode } from '../data/profile';
import { HALO, MAIN, INNER, crown } from '../data/merlinFire';
interface Props { id: Episode['id']; title: string; uid: string }
const { id, title, uid } = Astro.props;
---
<div class:list={['poster', `poster--${id}`]}>
  {id === 'merlin' && (
    <>
      <div class="poster__ground" style="background:#14213D"></div>
      <svg class="poster__svg" viewBox="0 0 380 320" aria-hidden="true">
        <defs><pattern id={`mer-dots-${uid}`} width="9" height="9" patternUnits="userSpaceOnUse"><circle cx="4.5" cy="4.5" r="1.8" fill="#2EC4D6" opacity=".22"></circle></pattern></defs>
        <rect x="0" y="0" width="380" height="320" fill={`url(#mer-dots-${uid})`}></rect>
        <g transform="translate(190 286) scale(1 0.3)" fill="none" stroke="#2EC4D6">
          <circle r="120" stroke-width="7"></circle><circle r="96" stroke-width="3.5"></circle>
          <path d="M0 -96 L83 48 L-83 48 Z M0 96 L83 -48 L-83 -48 Z" stroke-width="4"></path>
        </g>
        <svg x="62" y="6" width="256" height="290" viewBox="-30 -70 260 294">
          <path d={crown(HALO, 0)} fill="#1597BE" opacity="0.45"></path>
          <path d={crown(MAIN, 0)} fill="#2EC4D6" stroke="#0B1222" stroke-width="3.5" stroke-linejoin="round"></path>
          <path d={crown(INNER, 0)} fill="#C9F5FA"></path>
          <path d="M52 106 Q46 54 100 48 Q154 54 148 106 Q148 124 132 130 L128 142 L72 142 L68 130 Q52 124 52 106 Z" fill="#F1EDE3" stroke="#0B1222" stroke-width="3.5" stroke-linejoin="round"></path>
          <path d="M120 58 L113 72 L121 78" fill="none" stroke="#0B1222" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <ellipse cx="78" cy="102" rx="16" ry="18" fill="#0B1222"></ellipse><ellipse cx="122" cy="102" rx="16" ry="18" fill="#0B1222"></ellipse>
          <circle cx="80" cy="106" r="5.5" fill="#2EC4D6"></circle><circle cx="120" cy="106" r="5.5" fill="#2EC4D6"></circle>
          <path d="M95 120 L105 120 L100 128 Z" fill="#0B1222"></path>
          <path d="M84 133 V142 M92 132 V142 M100 132 V142 M108 132 V142 M116 133 V142" stroke="#0B1222" stroke-width="2.5" stroke-linecap="round"></path>
          <path d="M72 142 L128 142 Q131 162 116 168 L84 168 Q69 162 72 142 Z" fill="#F1EDE3" stroke="#0B1222" stroke-width="3.5" stroke-linejoin="round"></path>
          <path d="M86 142 V152 M95 142 V153 M105 142 V153 M114 142 V152" stroke="#0B1222" stroke-width="2.5" stroke-linecap="round"></path>
        </svg>
      </svg>
    </>
  )}
  {id === 'thriftbite' && (
    <>
      <div class="poster__ground" style="background:#0A7C8A"></div>
      <svg class="poster__svg" viewBox="0 0 380 300" aria-hidden="true">
        <defs><pattern id={`tb-dots-${uid}`} width="9" height="9" patternUnits="userSpaceOnUse"><circle cx="4.5" cy="4.5" r="2" fill="#102326" opacity=".35"></circle></pattern></defs>
        <rect x="0" y="0" width="380" height="300" fill={`url(#tb-dots-${uid})`}></rect>
        <g transform="rotate(-9 120 150)">
          <path d="M40 92 H170 L206 150 L170 208 H40 Z" fill="#102326" transform="translate(8 8)"></path>
          <path d="M40 92 H170 L206 150 L170 208 H40 Z" fill="#A6D94A" stroke="#102326" stroke-width="5" stroke-linejoin="round"></path>
          <circle cx="174" cy="150" r="9" fill="#0A7C8A" stroke="#102326" stroke-width="4"></circle>
          <text x="102" y="167" text-anchor="middle" font-family="Archivo, sans-serif" font-size="52" font-weight="800" fill="#102326">-50%</text>
        </g>
      </svg>
      <img class="poster__mascot" src="/projects/thryx-full.webp" alt="" width="360" height="352" loading="lazy" decoding="async">
    </>
  )}
  {id === 'kadugo' && (
    <>
      <div class="poster__ground" style="background:#e4ddd6"></div>
      <svg class="poster__svg" viewBox="0 0 380 340" aria-hidden="true">
        <defs><pattern id={`kd-dots-${uid}`} width="9" height="9" patternUnits="userSpaceOnUse"><circle cx="4.5" cy="4.5" r="2.3" fill="#2a0605"></circle></pattern></defs>
        <path d="M150 30 C112 98 66 146 66 206 a84 84 0 0 0 168 0 c0 -60 -46 -108 -84 -176z" fill={`url(#kd-dots-${uid})`} transform="translate(16 16)"></path>
        <path d="M150 30 C112 98 66 146 66 206 a84 84 0 0 0 168 0 c0 -60 -46 -108 -84 -176z" fill="#82121f"></path>
        <path d="M112 196 C112 230 130 250 156 256" fill="none" stroke="#f2eeea" stroke-width="7" stroke-linecap="round"></path>
        <g transform="rotate(6 290 200)">
          <rect x="236" y="96" width="112" height="196" fill="#f2eeea" stroke="#2a0605" stroke-width="7"></rect>
          <rect x="250" y="122" width="84" height="16" fill="#e4ddd6"></rect>
          <rect x="250" y="146" width="84" height="16" fill="#82121f"></rect>
          <rect x="250" y="170" width="84" height="16" fill="#e4ddd6"></rect>
          <rect x="250" y="250" width="50" height="16" fill="#2a0605"></rect>
        </g>
      </svg>
    </>
  )}
  <p class="poster__title">{title}</p>
</div>
