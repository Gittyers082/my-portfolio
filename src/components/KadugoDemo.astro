---
/**
 * Ka-dugo demo loop: the real app, played like a muted clip. Each step is a
 * screenshot of the actual pages (taken with sample data, not a redraw):
 * a donor books a slot, shows their admission pass, and the bank scans them in.
 * Logic: src/scripts/features.ts (initDemo), shared with Merlin and ThriftBite.
 * Without JavaScript the first screen shows and the controls stay hidden.
 */
const steps = ['Book a slot', 'Show the pass', 'Scan in'];
const shots = [
  { src: '/projects/kadugo-book.webp', alt: 'Ka-dugo’s Drives and Booking page: a Saturday blood drive at SLU Gym opened, with the 10:00 AM slot picked and a Book Selected Slot button.', label: 'Step 1 of 3: a donor books a 10:00 slot at a blood drive' },
  { src: '/projects/kadugo-pass.webp', alt: 'Ka-dugo’s Donor Dashboard: eligible to donate today, blood type O+, and a Fast Admission Pass with the donor’s QR code.', label: 'Step 2 of 3: the donor dashboard with the QR admission pass' },
  { src: '/projects/kadugo-scan.webp', alt: 'Ka-dugo’s bank Scanner: Log New Donation, with the donor’s record matched, O+, 62.5 kg, last collection 132 days ago, and Eligible to Donate.', label: 'Step 3 of 3: the blood bank scans the donor in and checks eligibility' },
];
---
<figure class="demo demo--kadugo" data-demo data-step="0">
  <div class="demo__frame">
    <div class="screen screen--kd" data-ui>
      <div class="screen__bar">
        <span class="screen__dot"></span><span class="screen__dot"></span><span class="screen__dot"></span>
        <span class="screen__url">Ka-dugo</span>
        <span class="demo__status" aria-hidden="true"><span class="demo__rec"></span><span class="demo__status-text">Demo loop</span></span>
      </div>
      <div class="screen__body kd" aria-live="off">
        {shots.map((s, i) => (
          <div class="demo__screen kd__shot" data-screen={i} aria-label={s.label}>
            <img src={s.src} alt={s.alt} width="1280" height="880" loading="lazy" decoding="async">
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="demo__controls" hidden>
    <button type="button" class="demo__play" aria-label="Pause demo" data-demo-play>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path class="demo__icon-pause" d="M4 3 H8 V17 H4 Z M12 3 H16 V17 H12 Z"></path><path class="demo__icon-play" d="M5 3 L17 10 L5 17 Z"></path></svg>
    </button>
    {steps.map((label, i) => (
      <button type="button" class="demo__step" data-demo-step={i} aria-pressed={i === 0 ? 'true' : 'false'}>
        <span class="demo__step-label">{label}</span>
        <span class="demo__track"><span class="demo__fill"></span></span>
      </button>
    ))}
  </div>
  <figcaption class="demo__caption">Screens from the real app, shown with sample data. Hover to pause.</figcaption>
</figure>
